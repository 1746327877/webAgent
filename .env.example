# 可选：docker compose 变量。不创建 .env 时使用 compose 内置默认值（仅供本机演示）
PG_PWD=webagent
JWT_SECRET=change-me-to-32-random-chars-0123456789
# 宿主机 Ollama（Docker 内用 host.docker.internal 访问）
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# 宿主机 MinerU 文档解析服务；留空 = 不启用（回退内置 pymupdf/docx，无 OCR）
# 启用前先在宿主机跑 scripts/start-mineru.ps1（默认 8001 端口）
# MINERU_API_URL=http://host.docker.internal:8001
# 解析后端：pipeline 支持纯 CPU；hybrid/vlm 需要 CUDA（默认 hybrid 会报 CUDA is not available）
# MINERU_BACKEND=pipeline
# 联网搜索 MCP（compose 服务 web-search）：默认搜索引擎与宿主端口
# WEB_SEARCH_ENGINE=bing
# WEB_SEARCH_PORT=3300
# 前端宿主端口；8080 常被 Steam（CEF 调试端口）等占用，默认用 8090
# FRONTEND_PORT=8090
