# 可选：docker compose 变量。不创建 .env 时使用 compose 内置默认值（仅供本机演示）
PG_PWD=webagent
JWT_SECRET=change-me-to-32-random-chars-0123456789
# 宿主机 Ollama（Docker 内用 host.docker.internal 访问）
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# 宿主机 MinerU 文档解析服务；留空 = 不启用（回退内置 pymupdf/docx，无 OCR）
# 启用前先在宿主机跑 scripts/start-mineru.ps1（默认 8001 端口）
# MINERU_API_URL=http://host.docker.internal:8001
# 解析后端：pipeline 支持纯 CPU；hybrid/vlm 需要 CUDA（默认 hybrid 会报 CUDA is not available）
# MINERU_BACKEND=pipeline
# 联网搜索 MCP（compose 服务 web-search）：默认搜索引擎与宿主端口
# WEB_SEARCH_ENGINE=bing
# WEB_SEARCH_PORT=3300
# 后端访问 web-search 的 MCP 地址：compose 内默认 http://web-search:3000/mcp
# 本地开发（后端跑在宿主机）改为 http://localhost:3300/mcp；留空则对话输入框按钮禁用
# WEB_SEARCH_MCP_URL=http://localhost:3300/mcp
# OCR MCP（部署方自备，如 PaddleOCR/Tesseract 封装的 http MCP）；留空则图片回合不挂 OCR 工具
# OCR_MCP_URL=http://host.docker.internal:8100/mcp
# 语音转写 MCP（外部 ASR 服务，见 docs/设计/23）。要求它能读到同一批上传文件：
# 容器内路径形如 /data/uploads/<uuid>.mp3，因此 ASR MCP 需挂同一个 uploads 卷（:ro 即可）。
# 工具名默认自动选探测结果里含 "transcribe" 的那个，可用 ASR_MCP_TOOL 覆盖。
# 留空则音频附件不转写（对话仍可用）。
# ASR_MCP_URL=http://voice-asr:10001/mcp
# ASR_MCP_TOOL=transcribe
# 是否每轮自动转写并注入上下文。默认 false：只提示存在音频附件，由模型按需调用
# 内置工具 transcribe_audio（平台负责读取附件；适合弱模型/显存吃紧，避免整份转写常驻上下文）
# ASR_AUTO_TRANSCRIBE=false
# 单个音频附件上限（默认 20MB）。base64 传入会放大 ~33%，需小于 MCP 侧上限（默认 64MB）
# ASR_MAX_BYTES=20971520
# 前端宿主端口；8080 常被 Steam（CEF 调试端口）等占用，默认用 8090
# FRONTEND_PORT=8090
# 后端宿主端口；部分 Windows 机器把 8000 划进 Hyper-V/WinNAT 保留段，容器会 bind 失败。
# 查保留段：netsh interface ipv4 show excludedportrange protocol=tcp
# BACKEND_PORT=8000
