# mcp_servers 本地 MCP 服务的环境变量（复制为 .env 后按需修改）
# 复制：Copy-Item mcp_servers\.env.example mcp_servers\.env

# 统一入口默认启动的服务（src/main.py 的 SERVICES 白名单）
MCP_SERVICE=mcp_voice2text
LOG_LEVEL=INFO

# ---- mcp_voice2text（本地 faster-whisper）----
VOICE_PORT=10001
# 模型：本机 HF 缓存里的 Systran/faster-whisper-large-v3（也可换 base 先验链路）
WHISPER_MODEL=Systran/faster-whisper-large-v3
# 有 N 卡时改成 cuda + float16，速度提升一个数量级
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=5
# CPU 上 Whisper 很吃算力，默认只允许 2 个并发转写
VOICE_MAX_PARALLEL=2
# streamable-http 单次请求体上限（MB）。SDK 默认 4MB；平台用 base64 传音频（放大 ~33%），
# 因此放宽到 64MB —— 要大于后端 .env 里 ASR_MAX_BYTES 的 1.34 倍
MCP_MAX_REQUEST_BODY_MB=64
